# Postgres connection (Supabase or any Postgres instance)
DATABASE_URL="postgresql://user:password@localhost:5432/ott_weekly_pulse"
DIRECT_URL="postgresql://user:password@localhost:5432/ott_weekly_pulse"

# NVIDIA NIM API (used for "Quick AI Verdict" generation — same pattern as SatiCast / SanghaStatus)
NVIDIA_API_KEY="nvapi-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
NVIDIA_NIM_BASE_URL="https://integrate.api.nvidia.com/v1"
NVIDIA_NIM_MODEL="meta/llama-3.1-70b-instruct"

# Optional real data sources (falls back to seeded mock data if unset)
# Setting WATCHMODE_API_KEY turns on LIVE weekly auto-updates via Watchmode,
# a dedicated streaming-availability API — recommended over TMDB for India-
# based development since TMDB has been intermittently blocked by several
# Indian ISPs for years. Free tier: 2,500 requests/month, no credit card.
# Get a key at https://api.watchmode.com/requestApiKey
WATCHMODE_API_KEY=""

# TMDB is supported as a second live option (used only if Watchmode isn't
# configured or returns nothing) in case you get a TMDB key via VPN, or
# deploy from a region where TMDB isn't blocked.
TMDB_API_KEY=""
TMDB_BASE_URL="https://api.themoviedb.org/3"
JUSTWATCH_LOCALE="en_IN"

# Optional: persistent Redis-backed cache for the live catalog (survives
# serverless cold starts, unlike the built-in in-memory cache). Completely
# optional — leave blank and everything still works, just with slightly
# less warm-cache benefit. Set these if you attach a Vercel KV / Upstash
# Redis integration to your project (check Vercel's current Storage /
# Marketplace docs for the exact setup flow, since this has changed).
KV_REST_API_URL=""
KV_REST_API_TOKEN=""

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional: weekly digest email via Resend (https://resend.com) — free
# tier, 3,000 emails/month. Leave blank to disable; the newsletter signup
# form still collects emails (for when you do configure this).
RESEND_API_KEY=""
RESEND_FROM_EMAIL="OTT Weekly Pulse <onboarding@resend.dev>"

# Optional: real browser push notifications for "Notify Me" reminders, via
# the open Web Push (VAPID) standard — no third-party service required.
# Generate a key pair once with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:you@example.com"

# Protects the /api/cron/* endpoints from being triggered by anyone who
# finds the URL. Vercel automatically sends this as a Bearer token on
# scheduled Cron runs — set it to any random string and it just works.
CRON_SECRET=""
